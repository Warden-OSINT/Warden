# --- apps/web (Vercel) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo desarrollo: "true" salta el login para ver el dashboard sin Supabase.
WARDEN_DEV_SKIP_AUTH=false

# --- apps/worker (contenedor) ---
SUPABASE_URL=http://127.0.0.1:54321
# Llave con privilegios de service role: solo en el worker, nunca en la web.
SUPABASE_SECRET_KEY=
# OpenRouter (resumen ejecutivo con IA): llave de https://openrouter.ai/keys y modelo
# (p. ej. "proveedor/modelo"; los gratuitos terminan en ":free"). Solo worker.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
SPIDERFOOT_URL=http://localhost:5001
# Have I Been Pwned: requiere suscripción y dominio previamente verificado; solo worker.
HIBP_API_KEY=
# abuse.ch (URLhaus y ThreatFox): Auth-Key gratuita de https://auth.abuse.ch; de la empresa, solo worker.
ABUSECH_AUTH_KEY=
# Cert Spotter (SSLMate): respaldo de crt.sh cuando no responde. Opcional; llave gratuita en
# https://sslmate.com/signup?for=ct_search_api, de la empresa. Sin ella el límite es menor. Solo worker.
CERTSPOTTER_API_KEY=
# Segundos que un mensaje queda invisible mientras el worker lo procesa.
QUEUE_VISIBILITY_TIMEOUT=900
# Alertas por correo (SMTP de la empresa: Microsoft 365, Google Workspace o un servicio gratuito).
# Sin SMTP_HOST las alertas se registran y su envío queda pendiente hasta configurarlo.
# En local: SMTP_HOST=127.0.0.1 y SMTP_PORT=54325 envían a Mailpit (http://127.0.0.1:54324).
SMTP_HOST=
SMTP_PORT=587
# true solo para TLS implícito (puerto 465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Remitente, p. ej. "Warden <alertas@empresa.com>". Obligatorio si hay SMTP_HOST.
ALERT_EMAIL_FROM=
# URL pública de la web, para el enlace al reporte en el correo (p. ej. https://warden.empresa.com).
WARDEN_WEB_URL=
